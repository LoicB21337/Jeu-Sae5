# --- Configuration commune (à éditer avant ./setup-vms.sh et ./deploy.sh) ---

# Version de Godot : DOIT être identique à celle des clients (voir README du projet)
GODOT_VERSION=4.7.2
# URL du binaire Linux (modifiable si le pattern change ou si vous utilisez un miroir)
GODOT_URL=https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_linux.x86_64.zip

# Dossier du projet Godot (celui qui contient project.godot), chemin relatif à ce dossier
GODOT_PROJECT_DIR=./jeu-sae-5

# Secrets : changez-les ! (lettres et chiffres uniquement, pour éviter les soucis de quoting)
API_KEY=changeme1234567890abcdef
DB_PASSWORD=changeme0987654321

# Réseau pour que les clients des autres PC joignent la VM "jeu".
# Vide  = réseau Multipass par défaut (seul le PC hôte peut jouer)
# bridged = VM visible sur le réseau local (voir README, étape 0)
NETWORK=
